{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 95,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"singleAttributePerLine": true,
	"ignorePatterns": [
		"packages/ui/src/**/*.css",
		"packages/web/src/index.css",
		"packages/web/src/routeTree.gen.ts",
		"packages/server/e2e/artifacts",
		"www/src/styles.css",
		"www/src/routeTree.gen.ts",
		"www/src/components/ui/tabs.tsx",
		"www/src/components/tabs.tsx",
		"www/src/components/codeblock.tsx",
		"t3-*/**",
		".agents/**",
		".claude/**",
		".codex/**",
		"marketing/**",
		"tools/oxlint/anti-slop/**",
		"www/.source/**",
		"skills-lock.json",
		"**/*.md",
		"**/*.mdx",
		"**/*.json",
		"**/*.jsonc",
		"**/*.yml",
		"**/*.yaml",
		"**/*.toml",
		"**/*.html",
		"**/*.css",
		"**/worker-configuration.d.ts"
	],
	"sortImports": {
		"newlinesBetween": false
	}
}
