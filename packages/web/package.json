    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@sentry/react": "^10.52.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^0.55.0",
    "@tanstack/ai-client": "^0.32.1",
    "@tanstack/ai-react": "^0.24.1",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.25",
    "@uiw/react-json-view": "^2.0.0-alpha.40",
    "@xyflow/react": "^12.12.0",
    "axios": "^1.21.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.66.0",
    "monaco-editor": "^0.57.0",
    "nanoid": "^6.0.2",
    "nuqs": "^2.10.2",
    "posthog-js": "^1.444.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
