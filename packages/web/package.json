    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "monaco-editor": "^0.56.0",
    "nanoid": "^6.0.1",
    "nuqs": "^2.8.5",
    "posthog-js": "^1.372.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "react-hotkeys-hook": "^5.2.1",
    "react-icons": "^5.6.0",
    "shadcn": "^4.3.0",
