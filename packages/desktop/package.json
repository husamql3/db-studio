{
  "name": "@db-studio/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "db-studio desktop app (Electron). Version is taken from packages/server at package time.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "Hüsam 🥑 <husam@ql3.dev>",
  "homepage": "https://dbstudio.sh",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsup",
    "electron": "tsup && node scripts/ensure-electron.mjs && node scripts/launch-electron.mjs",
    "stage:server": "node scripts/stage-server.mjs",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write --unsafe"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "0.28.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
