{
  "name": "db-studio",
  "type": "module",
  "version": "2.0.1",
  "description": "Every database. One studio. Browse tables, edit records, design schemas, and run queries across SQL, document, and key-value databases. Free and open source.",
  "keywords": [
    "database client",
    "database gui",
    "database browser",
    "sql client",
    "sql editor",
    "query tool",
    "table editor",
    "data editor",
    "postgres",
    "postgresql",
    "postgresql client",
    "postgresql gui",
    "mysql",
    "mysql client",
    "ai sql",
    "er diagram",
    "database management",
    "database studio"
  ],
  "author": "Hüsam 🥑 <husam@ql3.dev>",
  "homepage": "https://dbstudio.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/husamql3/db-studio.git"
  },
  "bugs": {
    "url": "https://github.com/husamql3/db-studio/issues"
  },
  "license": "Apache-2.0",
  "bin": {
    "db-studio": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "portless run",
    "dev:app": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsup --minify",
    "prepack": "cd ../web && bun run build && cd ../server && bun run build",
    "start": "sh -c 'APP_PORT=${PORT:-3333}; portless proxy start >/dev/null && portless alias db-studio \"$APP_PORT\" --force >/dev/null && HOST=127.0.0.1 PORT=\"$APP_PORT\" DB_STUDIO_SERVER_URL=https://db-studio.localhost node dist/index.js'",
    "format": "biome check --write --unsafe",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "tsx e2e/contract.ts",
    "e2e:perf": "tsx e2e/perf.ts",
    "e2e:grid": "tsx e2e/grid.ts",
    "e2e:schema-routing": "tsx e2e/schema-routing.ts",
    "e2e:visualizer": "tsx e2e/visualizer.ts"
  },
  "portless": {
    "name": "api.db-studio",
    "script": "dev:app"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@clickhouse/client": "^1.24.0",
    "@duckdb/node-api": "^1.5.6-r.1",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@libsql/client": "^0.18.0",
    "@sentry/node": "^10.73.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.0",
    "elysia": "^1.4.30",
    "ioredis": "^6.0.0",
    "mongodb": "^7.1.1",
    "mssql": "^12.2.0",
    "mysql2": "^3.18.2",
    "open": "^11.0.0",
    "oracledb": "^7.0.1",
    "pg": "^8.20.0",
    "picocolors": "^1.1.1",
    "posthog-node": "^5.20.0",
    "xlsx": "^0.18.5",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@db-studio/shared": "workspace:*",
    "@sentry/esbuild-plugin": "^5.4.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.0.0",
    "@types/oracledb": "^7.0.3",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^5.0.0",
    "playwright-core": "1.61.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
