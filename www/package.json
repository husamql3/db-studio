{
  "name": "@db-studio/www",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run",
    "dev:app": "vite dev --host 127.0.0.1 --port=${PORT:-3000}",
    "build": "vite build",
    "preview": "portless www.db-studio bun run preview:app",
    "preview:app": "vite preview --host --port=${PORT:-3000}",
    "deploy": "bun run build && wrangler deploy",
    "deploy:preview": "bun run build && wrangler deploy --env preview",
    "cf-typegen": "wrangler types",
    "check-meta": "bunx check-site-meta",
    "typecheck": "bun check",
    "test": "vitest run"
  },
  "portless": {
    "name": "www.db-studio",
    "script": "dev:app"
  },
  "dependencies": {
    "@db-studio/shared": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "@types/three": "^0.187.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.17.9",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.9",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@tanstack/devtools-vite": "^0.8.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
