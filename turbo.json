{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".vercel/**"
      ],
      "env": [
        "NODE_ENV"
      ],
      "passThroughEnv": [
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "db-studio#build": {
      "dependsOn": [
        "@db-studio/web#build",
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "NODE_ENV"
      ],
      "passThroughEnv": [
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "@db-studio/shared#build": {
      "outputs": [],
      "cache": true
    },
    "@db-studio/ui#build": {
      "outputs": [],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db-studio#dev": {
      "dependsOn": [
        "@db-studio/web#build"
      ],
      "cache": false,
      "persistent": true
    },
    "format": {
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": true
    },
    "db-studio#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "cache": true
    },
    "deploy": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "outputs": []
    },
    "deploy:preview": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "outputs": []
    }
  },
  "globalDependencies": [
    "tsconfig.json",
    "package.json",
    "turbo.json",
    ".env",
    ".env.local"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI"
  ]
}
